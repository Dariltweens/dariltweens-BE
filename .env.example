# Copy to .env and adjust for your environment.
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-custom-domain.com

# PostgreSQL — JSONB + GinIndex require Postgres.
DATABASE_URL=postgres://mac@localhost:5432/fish_be

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Run tasks inline (no broker) in local/dev if you like:
# CELERY_TASK_ALWAYS_EAGER=True

# --- Railway ---
# Railway auto-injects RAILWAY_PUBLIC_DOMAIN, which settings.py adds to
# ALLOWED_HOSTS/CSRF_TRUSTED_ORIGINS automatically — no manual config needed.
# Wire DATABASE_URL / CELERY_BROKER_URL / CELERY_RESULT_BACKEND to the Postgres
# and Redis plugin variables via Railway's ${{ServiceName.VAR}} references.
# SECURE_SSL_REDIRECT=True  # default is True whenever DEBUG=False

# CORS — comma-separated list of allowed frontend origins.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Object storage (R2). Default is "r2"; set to "fake" for local dev/CI without
# R2 credentials.
# STORAGE_BACKEND=fake
# R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://cdn.example.com

# Email — console backend by default (prints to stdout). Use SMTP in production.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@dnl.local

# Notification inbox routing
DNL_ORDER_INBOX=orders@dnl.local
DNL_GENERAL_INBOX=info@dnl.local
DNL_CAREERS_INBOX=careers@dnl.local
DNL_ADMIN_INBOX=admin@dnl.local
